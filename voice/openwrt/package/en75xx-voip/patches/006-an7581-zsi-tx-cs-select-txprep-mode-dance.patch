+/*
+ * OEM transaction preamble (spi.ko ZSI_bytes_write/read): program the
+ * chip-select register and poke the control register before the wrapper
+ * starts moving bytes.  Must be called with zsi->lock held.
+ */
+static void zsi_prep_transaction_locked(struct en75xx_zsi *zsi)
+{
+	if (zsi->cs != 0xff)
+		writel(zsi->cs, zsi->base + ZSI_CS_SEL);
+
+	if (zsi->tx_prep) {
+		u32 v = readl(zsi->base + ZSI_CFG);
+
+		writel((v & ZSI_TX_PREP_KEEP) | ZSI_TX_PREP_SET,
+		       zsi->base + ZSI_CFG);
+	}
+}
+
