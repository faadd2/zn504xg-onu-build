 #define ZSI_CFG_VAL			0x0f030313u	/* OEM stock value */
 #define ZSI_EN_VAL			0x19
 
+/* Wrapper chip-select register: the OEM spi.ko writes the target cs
+ * before every transaction on HIR 0xE/0xC (ZSI_bytes_write/read). */
+#define ZSI_CS_SEL			0x014
+
+/* OEM per-transaction poke of the wrapper control register (reg 0x00):
+ * keep everything in KEEP, force the bits in SET.  After the first
+ * transaction the register converges to 0xf0030313 (the poke is
+ * idempotent), i.e. the OEM steady-state top byte is 0xf0, not the
+ * 0x0f programmed once at init. */
+#define ZSI_TX_PREP_KEEP		0xe0ffffefu
+#define ZSI_TX_PREP_SET		0xf0000010u
+
 /* SYS block (0x1fb00000) */
 #define SYS_IFACE_MODE			0x094
 #define  SYS_IFACE_MODE_MASK		GENMASK(3, 0)
@@ -58,6 +70,9 @@
