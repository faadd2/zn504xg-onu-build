 #define  SYS_RESET_SLIC0		BIT(0)
 /* Bit 25 is SFC2/PCM reset, not a ZSI/SLIC reset. */
+/* OEM SPI_Reset (HIR 0xC/0xE) additionally pulses bit 4 around the
+ * SLIC0 pulse; purpose undocumented, mirrored for fidelity. */
+#define  SYS_RESET_ZSI_BIT4		BIT(4)
 
