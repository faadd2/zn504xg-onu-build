# ONU 套件定制配置（叠加在官方 configs/an7581.config 之上，kconfig.pl + 合并）

# 目标设备：只编译用户持有的两台（zn504 主设备 + xg2010g），其余 an7581 设备
# 不编译（种子未选设备时会兜底编成全部 24 台，run 38517535582 实证）。
# 用户 10-15 拍板：保留这两台，其他设备等有相关设备时再添加。
#
# 多设备编译的正确姿势（target-metadata.pl 生成结构实证；build-15 stock 腿
# 12 台成功范式 + build-15 onu 腿/build-16 双腿/build-17 三连失败反证）：
# ① choice「Target Profile」里 MULTI_PROFILE 与具体设备符号互斥——profile 层
#   写任何 CONFIG_TARGET_<target>_DEVICE_<设备>=y 都会把 MULTI_PROFILE 挤掉
#   （defconfig 警告 changes choice state），per-device 菜单整体失效
#   （depends on TARGET_MULTI_PROFILE），退化为单台。**禁止在 profile 层选设备**；
# ② per-device rootfs 层（CONFIG_TARGET_DEVICE_<target>_<设备>）才是真正决定
#   出哪些镜像的开关：MULTI_PROFILE=y + 此层选 zn504/xg2010g = 只出这两台；
# ③ xg2010g 符号无 -ubi 后缀（ponwrt 种子实证）；种子默认在此层开了 12 台，
#   下面逐台关掉只留我们的两台。
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn504xg-d=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_gemtek_xg2010g=y
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5382a is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-ct is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-ct-usb-sfp is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-cu is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-cu-usb-sfp is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi-usb-sfp is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-tf-ubi is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_unionman_ung00a is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn515xg-d is not set

# 超级 ONU 套件（onu-suite 仓库 package/ 下十个包）
# 主包 PKG_NAME 已从上游同名改为 luci-app-onu（f50a168），符号 CONFIG_PACKAGE_luci-app-onu
CONFIG_PACKAGE_luci-app-onu=y
CONFIG_PACKAGE_luci-app-onu-internet=y
CONFIG_PACKAGE_luci-app-onu-iptv=y
CONFIG_PACKAGE_luci-app-onu-voice=y
CONFIG_PACKAGE_luci-app-onu-mgmt=y
CONFIG_PACKAGE_luci-app-onu-migrate=y

# 语音（Le9643 SLIC）内核支持：AN7581 AFE + slic machine driver
# 补丁见 kernel-patches/（ASoC AN7581 v6 系列 + 自研 machine/DT S）
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_AN7581=y
CONFIG_SND_SOC_AN7581_LE9643=y

# 按需追加其他包，示例：
# CONFIG_PACKAGE_luci-app-upnp=y
# CONFIG_PACKAGE_curl=y

# 第二版固化：测速工具链 + NPU 面板 + 首启默认配置
CONFIG_PACKAGE_luci-app-speedcheck=y
CONFIG_PACKAGE_luci-app-netspeedtest=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_zn504xg-defaults=y
CONFIG_PACKAGE_curl=y

# 警告：不要把 PPPoE 账号密码、设备 MAC/SN 等身份信息写进本文件（公开仓库可见）

# 设备选择机制说明见本文件头部（MULTI_PROFILE + per-device 层，profile 层禁选设备）

# 2.5G 口（EN8811H PHY）驱动+固件：官方种子设为 =m 只编译不进镜像
# （build-10/build-20 manifest 实证缺失），须显式 =y。kmod-libphy 依赖自动带入。
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y

