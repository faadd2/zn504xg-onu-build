ASoC machine driver for Airoha AN7581 wired to a Microsemi miSLIC
Le9643 PCM interface (ZN504XG-D POTS / FXS phone line).

Applies on top of upstream 200-02 (ASoC airoha: Add AFE and I2S driver
for Airoha AN7581), which creates sound/soc/mediatek/an7581/.  The
Le9643 control plane (SPI/HBI, hook, ring, DTMF) is handled by the
slic-le9643 SPI driver; this machine driver only creates the sound card
wiring the AFE FE DAIs (DL1/UL1) to the ETDM BE DAI.  The codec side is
snd-soc-dummy until the SLIC registers a real codec driver: the Le9643
PCM format (8 kHz, 16-bit, SoC clock master) is fixed in the BE link.

Signed-off-by: ZN504XG-D voice porting project
---
 sound/soc/mediatek/Kconfig                 |  10 ++
 sound/soc/mediatek/an7581/Makefile         |   1 +
 sound/soc/mediatek/an7581/an7581-le9643.c | 154 ++++++++++++++++++++++
 3 files changed, 165 insertions(+)

diff --git a/sound/soc/mediatek/Kconfig b/sound/soc/mediatek/Kconfig
--- a/sound/soc/mediatek/Kconfig
+++ b/sound/soc/mediatek/Kconfig
@@ -25,4 +25,13 @@ config SND_SOC_AN7581_WM8960
 	  Select Y if you have such device.
 	  If unsure select "N".
 
+config SND_SOC_AN7581_LE9643
+	tristate "ASoC machine driver for Airoha AN7581 with Le9643 SLIC (POTS)"
+	depends on SND_SOC_AN7581
+	select SND_SOC_DUMMY
+	help
+	  Machine driver wiring the AN7581 AFE ETDM DAI to the PCM interface
+	  of a Microsemi miSLIC Le9643 (FXS phone line) as found on the
+	  ZN504XG-D ONT.
+
 config SND_SOC_MT2701
diff --git a/sound/soc/mediatek/an7581/Makefile b/sound/soc/mediatek/an7581/Makefile
--- a/sound/soc/mediatek/an7581/Makefile
+++ b/sound/soc/mediatek/an7581/Makefile
@@ -6,4 +6,5 @@ snd-soc-an7581-afe-y := \
 	an7581-dai-etdm.o
 
 obj-$(CONFIG_SND_SOC_AN7581) += snd-soc-an7581-afe.o
 obj-$(CONFIG_SND_SOC_AN7581_WM8960) += an7581-wm8960.o
+obj-$(CONFIG_SND_SOC_AN7581_LE9643) += an7581-le9643.o
diff --git a/sound/soc/mediatek/an7581/an7581-le9643.c b/sound/soc/mediatek/an7581/an7581-le9643.c
new file mode 100644
index 000000000000..000000000001
--- /dev/null
+++ b/sound/soc/mediatek/an7581/an7581-le9643.c
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Airoha AN7581 ASoC machine driver for the Microsemi miSLIC Le9643
+ * PCM interface (ZN504XG-D POTS / FXS phone line).
+ *
+ * The Le9643 line control (SPI/HBI register access, hook detection,
+ * ringing, DTMF) is provided by the separate slic-le9643 SPI driver;
+ * this driver only creates the sound card, wiring the AFE front-end
+ * DAIs (DL1 playback / UL1 capture) to the ETDM back-end DAI that the
+ * SLIC PCM pins are strapped to.
+ *
+ * Until the SLIC side registers a real codec component, the BE link
+ * uses snd-soc-dummy: the Le9643 PCM format is fixed (8 kHz, 16-bit,
+ * SoC provides PCLK/FS, the SLIC is clock slave) so no codec-side
+ * hw_params negotiation is required for bring-up.
+ */
+
+#include <linux/module.h>
+#include <sound/soc.h>
+
+#include "an7581-afe-common.h"
+
+SND_SOC_DAILINK_DEFS(playback,
+		     DAILINK_COMP_ARRAY(COMP_CPU("DL1")),
+		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
+		     DAILINK_COMP_ARRAY(COMP_EMPTY(), COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(capture,
+		     DAILINK_COMP_ARRAY(COMP_CPU("UL1")),
+		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
+		     DAILINK_COMP_ARRAY(COMP_EMPTY(), COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(slic,
+		     DAILINK_COMP_ARRAY(COMP_CPU("ETDM")),
+		     DAILINK_COMP_ARRAY(COMP_CODEC("snd-soc-dummy",
+						   "snd-soc-dummy-dai")),
+		     DAILINK_COMP_ARRAY(COMP_EMPTY(), COMP_EMPTY()));
+
+static struct snd_soc_dai_link an7581_le9643_dai_links[] = {
+	/* FE */
+	{
+		.name = "le9643-playback",
+		.stream_name = "le9643-playback",
+		.trigger = {SND_SOC_DPCM_TRIGGER_POST,
+			    SND_SOC_DPCM_TRIGGER_POST},
+		.dynamic = 1,
+		.playback_only = 1,
+		SND_SOC_DAILINK_REG(playback),
+	},
+	{
+		.name = "le9643-capture",
+		.stream_name = "le9643-capture",
+		.trigger = {SND_SOC_DPCM_TRIGGER_POST,
+			    SND_SOC_DPCM_TRIGGER_POST},
+		.dynamic = 1,
+		.capture_only = 1,
+		SND_SOC_DAILINK_REG(capture),
+	},
+	/* BE: ETDM <-> Le9643 PCM (clock slave on the SLIC side) */
+	{
+		.name = "le9643-slic",
+		.no_pcm = 1,
+		.dai_fmt = SND_SOC_DAIFMT_DSP_B |
+			SND_SOC_DAIFMT_NB_NF |
+			SND_SOC_DAIFMT_CBC_CFC |
+			SND_SOC_DAIFMT_GATED,
+		SND_SOC_DAILINK_REG(slic),
+	},
+};
+
+static struct snd_soc_card an7581_le9643_card = {
+	.name = "an7581-le9643",
+	.owner = THIS_MODULE,
+	.dai_link = an7581_le9643_dai_links,
+	.num_links = ARRAY_SIZE(an7581_le9643_dai_links),
+};
+
+static int an7581_le9643_machine_probe(struct platform_device *pdev)
+{
+	struct device_node *platform_dai_node;
+	struct snd_soc_card *card = &an7581_le9643_card;
+	struct device_node *of_platform;
+	struct snd_soc_dai_link *dai_link;
+	int i, d, ret;
+
+	card->dev = &pdev->dev;
+
+	of_platform = of_get_child_by_name(pdev->dev.of_node, "platform");
+	if (of_platform) {
+		platform_dai_node = of_parse_phandle(of_platform, "sound-dai", 0);
+		of_node_put(of_platform);
+
+		if (!platform_dai_node) {
+			dev_err(&pdev->dev, "Failed to parse platform/sound-dai property\n");
+			return -EINVAL;
+		}
+	} else {
+		dev_err(&pdev->dev, "Property 'platform' missing or invalid\n");
+		return -EINVAL;
+	}
+
+	for_each_card_prelinks(card, i, dai_link) {
+		struct snd_soc_dai_link_component *platform;
+
+		dai_link->num_platforms = 2;
+		for_each_link_platforms(dai_link, d, platform) {
+			if (platform->name)
+				continue;
+			platform->of_node = platform_dai_node;
+		}
+	}
+
+	/*
+	 * The codec side is statically snd-soc-dummy (see DAILINK_DEFS
+	 * above); when a real Le9643 codec driver lands, a "codec" child
+	 * with a sound-dai phandle can be added here to override it.
+	 */
+
+	ret = devm_snd_soc_register_card(&pdev->dev, card);
+	if (ret) {
+		dev_err_probe(&pdev->dev, ret, "%s snd_soc_register_card fail\n",
+			      __func__);
+		of_node_put(platform_dai_node);
+		return ret;
+	}
+
+	return 0;
+}
+
+static const struct of_device_id an7581_le9643_machine_dt_match[] = {
+	{ .compatible = "airoha,an7581-slic-sound" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, an7581_le9643_machine_dt_match);
+
+static struct platform_driver an7581_le9643_driver = {
+	.driver = {
+		   .name = "an7581-le9643",
+		   .of_match_table = an7581_le9643_machine_dt_match,
+	},
+	.probe = an7581_le9643_machine_probe,
+};
+module_platform_driver(an7581_le9643_driver);
+
+MODULE_DESCRIPTION("Airoha AN7581 ASoC machine driver for Le9643 SLIC (POTS)");
+MODULE_LICENSE("GPL");
-- 
